# ==============================================================================
# 2SR Innovations — Server-Side Environment Configuration
# ==============================================================================
# All credentials here remain strictly on the server and are NEVER exposed to browsers.

# Recipient for all corporate enquiries (Defaults to roohi.salar@2srinnovations.com)
CONTACT_NOTIFICATION_EMAIL=roohi.salar@2srinnovations.com

# ------------------------------------------------------------------------------
# Option A: Resend API (Recommended, Fast & Free Tier)
# Get a free key at https://resend.com
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL="2SR Enquiries <enquiries@yourdomain.com>"

# ------------------------------------------------------------------------------
# Option B: Standard SMTP (Gmail, Zoho, Outlook, or cPanel Mail)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-char-app-password

# ------------------------------------------------------------------------------
# Option C: Cloudflare Turnstile (Suspicious Activity Protection)
# Invisible security check triggered only when anomalous bot/rapid activity is detected
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAA...
